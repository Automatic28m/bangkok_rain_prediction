# Copy this file to .env and fill in your values. Never commit .env.
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env

# TMD API token from https://data.tmd.go.th/nwpapi/ (starts with eyJ, over 1000 characters).
# Leave empty to use mock data only.
TMD_API_TOKEN=

# HTTP port for the web app (default 8080)
PORT=8080
